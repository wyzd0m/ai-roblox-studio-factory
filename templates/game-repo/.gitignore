# Build artifacts
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
build.rbxl
*.lock

# ...but committed instance artifacts ARE source, not build output. Keep .rbxmx ignored generally
# (stray exports / syncback temp files) and track the map (M1) + imported meshes (M3):
!/map/*.rbxmx
!/assets/meshes/*.rbxmx

# Blender pipeline (M3): generated FBX are build artifacts — import them, don't commit them.
assets/blender/out/
*.fbx

